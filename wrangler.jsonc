{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mightykites-dynasty",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/.netlify/functions/*"]
  },
  "observability": {"enabled": false}
}
